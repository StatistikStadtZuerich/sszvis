{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "unicorn", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-underscore-dangle": "off",
    "import/no-unassigned-import": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "no-await-in-loop": "off",
    "unicorn/consistent-function-scoping": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.reference/**",
    "packages/geodata/src/**",
    "apps/docs/.react-router/**",
    "contrib/**",
    "apps/regression-cli/__export__/**",
    "apps/regression-cli/__report__/**"
  ],
  "overrides": [
    {
      "files": ["apps/regression-cli/src/commands/*.ts"],
      "rules": {
        "no-shadow": "off"
      }
    },
    {
      "files": ["apps/docs/examples/**/*.ts"],
      "rules": {
        "typescript/consistent-type-definitions": ["error", "type"],
        "func-style": ["error", "expression"]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.js", "**/*.spec.js"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-this-alias": "off"
      }
    },
    /* A recipe's chart.ts is a template whose bindings may only be used by .tmpl code spliced in
       at emit time; a `_` prefix would leak into every generated chart. The emitted code is
       type-checked instead (src/recipes/tsconfig.json, compile.test.ts). */
    {
      "files": ["packages/chart-builder/src/recipes/*/chart.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
