{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/generated/**",
    "**/.cache/**",
    "**/.turbo/**",
    "packages/geodata/src/**",
    "**/contrib/**",
    "**/.reference/**",
    "apps/docs/docs/**",
    "**/test/snapshot/__results__/**",
    "apps/regression-cli/__export__/**",
    "apps/regression-cli/__report__/**",
  ],
}
