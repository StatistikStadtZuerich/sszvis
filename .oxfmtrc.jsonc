{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/generated/**",
    "**/.cache/**",
    "**/.turbo/**",
    "packages/geodata/src/**",
    "**/contrib/**",
    "**/.reference/**",
    "apps/docs/docs/**",
    "apps/new-docs/.react-router/**",
    // Critiques written by the impeccable design agent are a record of its review, not source.
    "apps/new-docs/.impeccable/**",
    "apps/new-docs/examples/_template.html",
    // Chart example datasets are generated exports, not hand-written source. The
    // per-example example.json metadata is edited by hand and stays formatted.
    "apps/new-docs/examples/**/*.json",
    "!apps/new-docs/examples/**/example.json",
    "**/test/snapshot/__results__/**",
    "apps/regression-cli/__export__/**",
    "apps/regression-cli/__report__/**",
    // Coding-agent assets - skills, prompts and configuration installed by each tool - are not
    // owned source, and each tool rewrites its own directory in its own style.
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
  ],
}
