{
  "name": "sszvis-monorepo",
  "private": true,
  "description": "Monorepo for the Statistik Stadt Zürich Visualization Library",
  "repository": {
    "type": "git",
    "url": "https://github.com/StatistikStadtZuerich/sszvis.git"
  },
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@effect/tsgo": "latest",
    "@semantic-release/changelog": "^7.0.0",
    "concurrently": "^9.1.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "playwright": "^1.55.0",
    "semantic-release": "^25.0.9",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.1"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=sszvis",
    "test:snapshot": "turbo run test:snapshot --filter=sszvis",
    "type-check": "turbo run type-check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run format:check",
    "regression": "node scripts/visual-regression/server.mjs",
    "regression:crawl": "node scripts/visual-regression/crawl.mjs",
    "regression:export": "node scripts/visual-regression/export.mjs",
    "generate:changelogs": "semantic-release",
    "build:topo": "turbo run build --filter=@sszvis/geodata"
  }
}
