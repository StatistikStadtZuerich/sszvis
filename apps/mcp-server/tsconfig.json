{
  "extends": "@repo/config-typescript/base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    // Effect v4 sources import with explicit `.ts`; vite resolves it.
    "allowImportingTsExtensions": true,
    // @sszvis/chart-builder ships TypeScript source, so it is checked under this config
    // too; these match the vite config it is written against.
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*", "test/**/*", "vite.config.ts", "vite.ui.config.ts"],
  "exclude": ["node_modules", "dist", "ui", "test/**/*.browser.test.ts"]
}
