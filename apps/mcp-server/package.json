{
  "name": "@sszvis/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "Prototype MCP server that serves the sszvis chart builder as MCP Apps",
  "license": "BSD-3-Clause",
  "type": "module",
  "dependencies": {
    "@effect/platform-node": "4.1.5",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@repo/config-typescript": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/index.js",
    "start": "tsx src/index.ts",
    "start:watch": "tsx watch src/index.ts",
    "inspector": "npx @mcpjam/inspector@latest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  }
}
