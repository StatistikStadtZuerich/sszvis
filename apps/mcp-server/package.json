{
  "name": "@sszvis/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "Prototype MCP server that serves the sszvis chart builder as MCP Apps",
  "license": "BSD-3-Clause",
  "type": "module",
  "dependencies": {
    "@effect/platform-node": "4.1.5",
    "@sszvis/chart-builder": "workspace:^",
    "@sszvis/geodata": "workspace:^",
    "effect": "4.1.5",
    "ts-blank-space": "^0.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/core": "^2",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.1",
    "d3": "^7.9.0",
    "playwright": "^1.55.0",
    "sszvis": "workspace:^",
    "topojson-client": "^3.1.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.1",
    "zod": "^4.2.0"
  },
  "scripts": {
    "build": "pnpm run build:ui && vite build --configLoader runner",
    "build:ui": "vite build --configLoader runner -c vite.ui.config.ts",
    "start": "pnpm run build && node dist/index.js",
    "inspector": "npx @mcpjam/inspector@latest",
    "type-check": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "pnpm run build:ui && vitest run && vitest run --config vitest.browser.config.ts",
    "clean": "rm -rf dist ui/dist .turbo"
  }
}
