// #label Colour legend
// #hint Names each slice below the chart.

// #scalar BOTTOM_PADDING legendLayout.bottomPadding

// #region preBounds
// NOTE: The labels run horizontally, so the legend reserves a fixed padding for
// the axis and never measures `axisLabels`.
const legendLayout = sszvis.colorLegendLayout({ legendLabels: cScale.domain() }, config.id);
// #endregion

// #region components
// NOTE: The layout sizes the legend and picks a scale of its own on the way; the
// chart's colours are the chart's, so the swatches are keyed to the same scale the
// marks are rather than to whatever the layout would have chosen. The layout is
// fed that scale's domain for the same reason: a gender scale names values of its
// own, and a legend sized for the chart's categories would not hold them.
const colorLegend = legendLayout.legend.scale(cScale);
// #endregion

// #region render
chartLayer
  .selectGroup("colorLegend")
  .attr(
    "transform",
    sszvis.translateString(0, chartDimensions.totalHeight + legendLayout.axisLabelPadding),
  )
  .call(colorLegend);
// #endregion
