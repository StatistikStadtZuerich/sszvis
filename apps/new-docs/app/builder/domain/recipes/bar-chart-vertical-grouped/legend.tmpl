// #label Colour legend
// #hint Names each bar within a group.

// #scalar C_SCALE legendLayout.scale
// #scalar BOTTOM_PADDING legendLayout.bottomPadding

// #region preBounds
// NOTE: The legend decides how much room the chart has to leave below it,
// so it is laid out before the bounds it feeds into.
const legendLayout = sszvis.colorLegendLayout(
  {
    axisLabels: state.xValues,
    legendLabels: state.categories,
    slant: props.textDirection,
  },
  config.id,
);

const colorLegend = legendLayout.legend;
// #endregion

// #region render
chartLayer
  .selectGroup("colorLegend")
  .attr("transform", sszvis.translateString(0, bounds.innerHeight + legendLayout.axisLabelPadding))
  .call(colorLegend);
// #endregion
