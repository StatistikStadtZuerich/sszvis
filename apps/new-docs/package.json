{
  "name": "@sszvis/new-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React Router + MDX documentation site for sszvis",
  "license": "BSD-3-Clause",
  "scripts": {
    "clean": "rm -rf build .react-router .turbo",
    "build": "react-router build",
    "dev": "react-router dev --port ${PORT:-3000}",
    "type-check": "react-router typegen && tsc --noEmit && tsc --noEmit -p examples/tsconfig.json && tsc --noEmit -p app/builder/domain/recipes/tsconfig.json",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:node": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect/atom-react": "4.0.0-rc.115",
