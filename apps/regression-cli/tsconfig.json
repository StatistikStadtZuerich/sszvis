{
  "extends": "@repo/config-typescript/base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    // Effect v4 sources import with explicit `.ts`; tsx and esbuild both resolve it.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
