{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".oxlintrc.json",
    ".oxfmtrc.jsonc",
    "tsconfig.json",
    "pnpm-workspace.yaml"
  ],
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!playwright.config.js",
        "!vitest.config.js",
        "!README.md",
        ".env*"
      ],
      "outputs": ["build/**", "dist/**"],
      "outputLogs": "new-only"
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputLogs": "new-only"
    },
    "test": {
      "outputLogs": "new-only"
    },
    "test:snapshot": {
      "dependsOn": ["sszvis#build", "@sszvis/docs#build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "interruptible": true,
      "env": ["PORT"]
    },
    "build:watch": {
      "persistent": true,
      "cache": false,
      "interruptible": true
    },
    "clean": {
      "cache": false
    }
  }
}
